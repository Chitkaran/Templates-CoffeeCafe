rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'chitkaran@gmail.com';
    }

    function isValidTextLayersDoc(data) {
      return data.keys().hasAll(['layers', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['layers', 'updatedAt', 'updatedBy'])
        && data.layers is list
        && data.layers.size() >= 1
        && data.layers.size() <= 20
        && data.layers[0] is map
        && data.updatedAt == request.time
        && data.updatedBy is string
        && data.updatedBy == request.auth.uid
        && data.updatedBy.size() <= 128;
    }

    // Site typography & editable text layers (public copy, no PII)
    match /siteConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'textLayers';
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(configId)
        && configId == 'textLayers'
        && isValidTextLayersDoc(incoming())
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(configId)
        && configId == 'textLayers'
        && isValidTextLayersDoc(incoming())
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['layers', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }
  }
}
